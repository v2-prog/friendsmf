# Copy to .env and export these (the app reads process.env; it has no dotenv dependency).
# Example:  set -a; . ./.env; set +a; npm start

# --- First sign-in -------------------------------------------------------------
# Creates (or restores) this person as a finance team user at start-up, so the
# assistant treasurer can sign in on a fresh install. Remove once roles are set up.
ADMIN_EMAIL=assistant.treasurer@friendsmf.com
ADMIN_NAME=Assistant Treasurer

# --- Where things live ---------------------------------------------------------
PORT=3000                       # member area
PUBLIC_PORT=3001                # public site (a separate app; can run on its own host)
BASE_URL=http://localhost:3000  # used in emailed links. Use https://friendsmf.com in production.
PUBLIC_URL=http://localhost:3001
DATA_DIR=./data                 # SQLite database, uploads, dev outbox

# --- Email ---------------------------------------------------------------------
# Leave SMTP_URL empty in development: messages are written to data/outbox and the
# sign-in link is shown on screen. NEVER leave it empty in production.
# SMTP_URL=smtps://user:password@smtp.example.org:465
# MAIL_FROM="Friends SMF" <treasurer@friendsmf.com>

# --- Production ----------------------------------------------------------------
# NODE_ENV=production
# TRUST_PROXY=1                 # only when behind a reverse proxy you control
# 32-byte key (64 hex chars) encrypting bequest, salary and bank details at rest.
# Generate:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Back it up separately from the database. Without it, those fields cannot be read.
# DATA_ENCRYPTION_KEY=
